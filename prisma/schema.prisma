datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model Juguete {
  id          Int      @id @default(autoincrement())
  nombre      String
  categoria   String
  descripcion String?
  imagenUrl   String?
  esFavorito  Boolean  @default(false)
  createdAt   DateTime @default(now())
}