datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Juguete {
  id         Int      @id @default(autoincrement())
  nombre     String
  categoria  String
  descripcion String?  // 👈 Nuevo campo opcional
  imagenUrl   String?  // 👈 Nuevo campo opcional
  esFavorito Boolean  @default(false)  // 👈 AQUÍ ESTÁ LO NUEVO
  createdAt   DateTime @default(now())
}